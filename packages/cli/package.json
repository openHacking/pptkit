{
  "name": "@pptkit/cli",
  "version": "0.2.0-preview.0",
  "private": false,
  "type": "module",
  "description": "Command-line entry points for PPTKit.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pptkit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@pptkit/core": "workspace:*",
    "@pptkit/pptx-exporter": "workspace:*",
    "@pptkit/svg-renderer": "workspace:*",
    "@pptkit/pptx-parser": "workspace:*"
  }
}
