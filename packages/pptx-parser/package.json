{
  "name": "@pptkit/pptx-parser",
  "version": "0.2.0-preview.0",
  "private": false,
  "type": "module",
  "description": "Bounded PPTX inspection, partial content import and original-byte sessions for PPTKit.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pptkit/core": "workspace:*",
    "@pptkit/media-inspection": "workspace:*",
    "fflate": "^0.8.3",
    "saxes": "6.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-browser-bundle.mjs @pptkit/pptx-parser",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
